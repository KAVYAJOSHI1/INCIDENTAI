# Copy this file to .env and fill in a key to enable real LLM reasoning
# (severity scoring, root cause prediction, developer copilot chat).
# Without either key set, the backend automatically falls back to the
# deterministic rule-based logic in server/services/ — nothing breaks either way.
# If both are set, Anthropic is tried first and Groq is used as a fallback.

ANTHROPIC_API_KEY=

# Free at console.groq.com — uses llama-3.3-70b-versatile. Used when
# ANTHROPIC_API_KEY is unset, or as an automatic fallback if an Anthropic call fails.
GROQ_API_KEY=

# Optional: override the backend port (default 4000)
# PORT=4000

# Postgres connection. Defaults below match docker-compose.yml — override with
# DATABASE_URL, or leave unset and run `docker compose up -d` for local dev.
# DATABASE_URL=postgres://incidentai:incidentai@localhost:5432/incidentai
# PGHOST=localhost
# PGPORT=5432
# PGUSER=incidentai
# PGPASSWORD=incidentai
# PGDATABASE=incidentai

# Optional: enable real Voyage AI embeddings (voyage-3.5) for pgvector semantic
# search in duplicate detection and knowledge base retrieval. Without this key,
# the backend automatically falls back to the existing TF-IDF cosine similarity.
VOYAGE_API_KEY=

# Secret used to sign login JWTs. Set this in any real deployment — without it,
# the backend generates a random secret at process startup (logged as a warning),
# which works fine for local dev but invalidates every issued token on restart.
JWT_SECRET=
